# Application
PYTHON_ENV=dev
APP_NAME=CCODEL Tickets
APP_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://localhost:8000

# Authentication
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
SECRET_KEY=replace-with-a-long-random-secret

# Database (the database URL also lives in .env.config.sample for compatibility)
DB_URL=postgresql://user:password@host:5432/database

# File storage
STORAGE_BACKEND=cloudinary
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ccodel_tickets
CLOUDINARY_PRIVATE_DOWNLOAD_TTL=3600

# Email notifications
MAIL_ENABLED=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True

# Initial admin seed (used by scripts/seed.py)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
ADMIN_MATRIC_NUMBER=

# Test database (never point this at production)
TEST_DATABASE_URL=
